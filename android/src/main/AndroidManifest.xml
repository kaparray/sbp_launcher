<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" /><!--загрузка c2bmembers.json-->

    <!--
    Видимость банковских приложений (Android 11+) без статического списка пакетов:
    1. любые приложения, которые открывают ссылки СБП вида bankXXXXXXXXXXXX://qr.nspk.ru;
    2. приложения, которые открывают https://qr.nspk.ru.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="*" android:host="qr.nspk.ru" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="qr.nspk.ru" />
        </intent>
    </queries>
</manifest>
